# ==========================================
# MorningBrief - Environment Configuration
# ==========================================

# ------------------------------------------
# Django Settings
# ------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend,testserver
TIMEZONE=Asia/Kolkata

# ------------------------------------------
# Database Configuration
# Local dev default: SQLite (sqlite:///db.sqlite3)
# Docker / Production: PostgreSQL
# ------------------------------------------
DATABASE_URL=postgresql://morningbrief:morningbrief_secret_password@localhost:5432/morningbrief
POSTGRES_DB=morningbrief
POSTGRES_USER=morningbrief
POSTGRES_PASSWORD=morningbrief_secret_password
POSTGRES_PORT=5432

# ------------------------------------------
# Redis & Celery Configuration
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------
# JWT Authentication & CORS
# ------------------------------------------
JWT_SECRET_KEY=jwt-secret-key-replace-with-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------
# AI & LLM Providers
# ------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
LLM_MODEL_NAME=gpt-4o-mini

# ------------------------------------------
# External Data Connections & Integrations
# ------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

# ------------------------------------------
# Delivery Channels
# ------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-ses-smtp-password
DEFAULT_FROM_EMAIL=MorningBrief <briefings@morningbrief.dev>
