# ==========================================
# MorningBrief - Environment Configuration
# ==========================================

# ------------------------------------------
# Django Settings
# ------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend,testserver
TIMEZONE=Asia/Kolkata

# ------------------------------------------
# Database Configuration
# Local dev default: SQLite (sqlite:///db.sqlite3)
# Docker / Production: PostgreSQL
# ------------------------------------------
DATABASE_URL=postgresql://morningbrief:morningbrief_secret_password@localhost:5432/morningbrief
POSTGRES_DB=morningbrief
POSTGRES_USER=morningbrief
POSTGRES_PASSWORD=morningbrief_secret_password
POSTGRES_PORT=5432

# ------------------------------------------
# Redis & Celery Configuration
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------
# JWT Authentication & CORS
# ------------------------------------------
JWT_SECRET_KEY=jwt-secret-key-replace-with-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------
# Encryption Key (Fernet for sensitive tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------
FERNET_KEY=your-32-byte-base64-encoded-fernet-key-here

# ------------------------------------------
# AI & LLM Providers
# ------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
LLM_MODEL_NAME=llama-3.3-70b-versatile

# ------------------------------------------
# External Data Connections & Integrations
# ------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/gmail/callback/

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

# ------------------------------------------
# Delivery Channels
# ------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_TOKEN=your-telegram-bot-token-here

# Resend / SMTP Email Delivery
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=MorningBrief <onboarding@resend.dev>

# ------------------------------------------
# Frontend Environment (Vercel / Local)
# ------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1

# ------------------------------------------
# Render Keep-Alive & Task Dispatcher Cron
# ------------------------------------------
# Pinned to GET /api/v1/delivery/cron-dispatch/?key=morningbrief_cron_2025
CRON_SECRET=morningbrief_cron_2025

